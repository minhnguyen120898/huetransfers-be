# Server
API_PORT=3000
HOST=0.0.0.0
API_PREFIX=/api/v1
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres123@localhost:5433/huetransfers_db

# CORS
CORS_ORIGIN=*

# Swagger
SWAGGER_ENABLE=1

# Auth
JWT_SECRET=your-super-secret-key-min-32-characters-long
JWT_ISSUER=huetransfers-api

# Health
HEALTH_TOKEN=

# Email Configuration - Resend
# 1. Sign up at https://resend.com/signup
# 2. Add and verify your domain at https://resend.com/domains
# 3. Get API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=Huetransfers@gmail.com
EMAIL_FROM_NAME=Hue Transfers

# Application
APP_NAME=Hue Transfers
APP_URL=http://localhost:3000
SUPPORT_EMAIL=Huetransfers@gmail.com
